{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "nova-build",
      "type": "shell",
      "command": "cargo build",
      "group": "build",
      "problemMatcher": ["$rustc"],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "webapp-dev",
      "type": "shell",
      "command": "npm run dev",
      "group": "build",
      "options": {
        "cwd": "${workspaceFolder}/webapp"
      }
    }
  ]
}
